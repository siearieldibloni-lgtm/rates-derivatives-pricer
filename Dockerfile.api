# API image: FastAPI service (uvicorn), JSON logs on stdout, snapshots baked in /app/data/market.
# Build: docker build -f Dockerfile.api --build-arg GIT_COMMIT=$(git rev-parse HEAD) -t pricer-api .

# ---------------------------------------------------------------- build stage: locked venv
FROM python:3.12-slim AS build
COPY --from=ghcr.io/astral-sh/uv:0.13.5 /uv /bin/uv
# Bytecode compiled at build time; copy (not hardlink) into the venv; never download a Python.
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never
WORKDIR /app
# Dependencies first: this layer is reused as long as uv.lock does not change.
COPY pyproject.toml uv.lock README.md ./
RUN uv sync --locked --no-dev --extra api --no-install-project
# Then the project itself, installed as a regular (non-editable) package.
COPY src ./src
RUN uv sync --locked --no-dev --extra api --no-editable

# ---------------------------------------------------------------- runtime stage: no uv, no sources
FROM python:3.12-slim AS runtime
ARG GIT_COMMIT=unknown
ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    LOG_LEVEL=INFO \
    LOG_FORMAT=json \
    MARKET_DATA_DIR=/app/data/market \
    GIT_COMMIT=${GIT_COMMIT}
RUN useradd --create-home --uid 10001 pricer
WORKDIR /app
COPY --from=build /app/.venv /app/.venv
COPY data/market /app/data/market
USER pricer
EXPOSE 8000
HEALTHCHECK --interval=10s --timeout=3s --start-period=10s --retries=5 \
    CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/ready', timeout=2)"]
# One worker: the curve cache, the log buffer and the metrics are per process (ADR-005, ADR-037).
# Uvicorn's access log is off: the API logs its own request_completed event with the request_id.
CMD ["uvicorn", "rate_derivatives_pricer.api.main:app", "--host", "0.0.0.0", "--port", "8000", "--no-access-log"]
